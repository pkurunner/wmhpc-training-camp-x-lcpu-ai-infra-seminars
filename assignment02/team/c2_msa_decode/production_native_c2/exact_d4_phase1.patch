+     CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 13.0)
+    cuda_archs_loose_intersection(NATIVE_C2_MSA_ARCHS "10.3f" "${CUDA_ARCHS}")
+    if(NATIVE_C2_MSA_ARCHS)
+      set(NATIVE_C2_MSA_SRC
+        "csrc/libtorch_stable/attention/minimax_m3/native_c2_decode.cu")
+      set_gencode_flags_for_srcs(
+        SRCS "${NATIVE_C2_MSA_SRC}"
+        CUDA_ARCHS "${NATIVE_C2_MSA_ARCHS}")
+      list(APPEND VLLM_STABLE_EXT_SRC "${NATIVE_C2_MSA_SRC}")
+    endif()
+  endif()
 
