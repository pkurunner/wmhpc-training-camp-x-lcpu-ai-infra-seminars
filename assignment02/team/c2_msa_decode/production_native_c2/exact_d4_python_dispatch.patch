index 000000000..d1c472525
--- /dev/null
+++ b/vllm/models/minimax_m3/nvidia/msa_native_c2_decode.py
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Strict dispatch gate for the B300 native C2 MiniMax M3 decode operator."""
+
+from __future__ import annotations
+
+import math
+from numbers import Real
+
+import torch
+
+from vllm import _custom_ops as ops
+from vllm.config.attention import MiniMaxM3MSADecodeBackend
+from vllm.platforms import current_platform
+
+_BATCH = 16
+_QUERY_HEADS = 64
+_KV_HEADS = 4
+_HEAD_DIM = 128
+_PAGE_SIZE = 128
+_TOPK = 16
+
+
+def supports_native_c2_sparse_decode(
+    *,
+    decode_backend: MiniMaxM3MSADecodeBackend,
+    num_q_heads: int,
+    num_kv_heads: int,
+    kv_cache_dtype: str,
+    page_size: int,
+    topk_blocks: int,
+) -> bool:
+    """Return whether static model geometry is eligible for native C2.
+
+    Runtime tensor and device checks intentionally remain in
+    :func:`native_c2_msa_decode`.  This function must not imply that a
+    particular decode call will take the native branch.
+    """
+    return (
+        decode_backend == "native_c2"
+        and current_platform.is_cuda()
+        and num_q_heads == _QUERY_HEADS
+        and num_kv_heads == _KV_HEADS
+        and kv_cache_dtype in ("fp8", "fp8_e4m3")
+        and page_size == _PAGE_SIZE
+        and topk_blocks == _TOPK
+    )
+
+
+def _has_native_c2_operator() -> bool:
+    return hasattr(torch.ops, "_C") and hasattr(torch.ops._C, "native_c2_msa_decode")
+
+
+def _positive_finite_scalar(value: object) -> bool:
+    return (
+        isinstance(value, Real)
+        and math.isfinite(float(value))
+        and float(value) > 0.0
+    )
+
+
+def _is_b300_device(device: torch.device) -> bool:
+    if device.type != "cuda":
+        return False
+    return torch.cuda.get_device_capability(device) == (10, 3)
+
+
+def native_c2_msa_decode(
+    *,
+    output: torch.Tensor,
+    query_fp8: torch.Tensor,
+    kv_cache: torch.Tensor,
+    topk: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_lens: torch.Tensor,
+    scale: float,
+    q_scale: float,
+    k_scale: float,
+    v_scale: float,
+) -> bool:
+    """Run native C2 only for its exact ABI; otherwise return ``False``.
+
+    There are deliberately no calls to ``contiguous``, ``split``, casting, or
+    output allocation here.  A ``False`` result tells the caller to use the
+    existing Triton path with its original tensors.
+    """
+    if not _has_native_c2_operator():
+        return False
+    if (
+        output.dtype != torch.bfloat16
+        or query_fp8.dtype != torch.float8_e4m3fn
+        or kv_cache.dtype != torch.float8_e4m3fn
+        or topk.dtype != torch.int32
+        or block_table.dtype != torch.int32
+        or seq_lens.dtype != torch.int32
+    ):
+        return False
+    tensors = (output, query_fp8, kv_cache, topk, block_table, seq_lens)
+    if not all(tensor.is_cuda and tensor.is_contiguous() for tensor in tensors):
+        return False
+    if not all(tensor.device == output.device for tensor in tensors):
+        return False
+    if not _is_b300_device(output.device):
+        return False
+    if query_fp8.shape != (_BATCH, _QUERY_HEADS, _HEAD_DIM):
+        return False
+    if output.shape != (_BATCH, _QUERY_HEADS, _HEAD_DIM):
+        return False
+    if (
+        kv_cache.ndim != 4
+        or kv_cache.shape[0] <= 0
+        or tuple(kv_cache.shape[1:]) != (_KV_HEADS, _PAGE_SIZE, 2 * _HEAD_DIM)
+    ):
+        return False
+    if topk.shape != (_BATCH, _KV_HEADS, _TOPK):
+        return False
+    if (
+        block_table.ndim != 2
+        or block_table.shape[0] != _BATCH
+        or block_table.shape[1] <= 0
+    ):
+        return False
+    if seq_lens.shape != (_BATCH,):
+        return False
+    if not all(
+        _positive_finite_scalar(value)
+        for value in (scale, q_scale, k_scale, v_scale)
+    ):
+        return False
+
+    ops.native_c2_msa_decode(
+        output,
+        query_fp8,
+        kv_cache,
+        topk,
+        block_table,
+        seq_lens,
+        float(scale),
+        float(q_scale),
+        float(k_scale),
+        float(v_scale),
+    )
+    return True
